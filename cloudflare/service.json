{
  "mode": "jobs",
  "port": 8080,
  "jobs": {
    "sync-users": {
      "cron": "17 * * * *",
      "command": [
        "python",
        "-m",
        "app.main"
      ],
      "required_env": [
        "FIREBASE_PROJECT_ID",
        "FIREBASE_CREDENTIALS_BASE64",
        "LEGACY_DB_HOST",
        "LEGACY_DB_NAME",
        "LEGACY_DB_USER",
        "LEGACY_DB_PASSWORD",
        "TARGET_DB_HOST",
        "TARGET_DB_NAME",
        "TARGET_DB_USER",
        "TARGET_DB_PASSWORD"
      ],
      "timeout_seconds": 1800,
      "dry_run_env": "SYNC_DRY_RUN"
    }
  },
  "env_names": [
    "EMAIL_ALERTS_ENABLED",
    "EMAIL_FROM",
    "EMAIL_TO",
    "FIREBASE_CREDENTIALS_BASE64",
    "FIREBASE_PROJECT_ID",
    "FIRESTORE_DATABASE_ID",
    "FIRESTORE_LOGS_ENABLED",
    "LEGACY_DB_HOST",
    "LEGACY_DB_NAME",
    "LEGACY_DB_PASSWORD",
    "LEGACY_DB_PORT",
    "LEGACY_DB_USER",
    "LOG_LEVEL",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_HEADERS",
    "SMTP_HOST",
    "SMTP_PASSWORD",
    "SMTP_PORT",
    "SMTP_USER",
    "SYNC_BATCH_SIZE",
    "SYNC_DRY_RUN",
    "TARGET_DB_HOST",
    "TARGET_DB_NAME",
    "TARGET_DB_PASSWORD",
    "TARGET_DB_PORT",
    "TARGET_DB_USER"
  ]
}
