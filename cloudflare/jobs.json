{
  "sync-users": {
    "cron": "17 * * * *",
    "command": [
      "python",
      "-m",
      "app.main"
    ],
    "required_env": [
      "FIREBASE_PROJECT_ID",
      "FIREBASE_CREDENTIALS_BASE64",
      "LEGACY_DB_HOST",
      "LEGACY_DB_NAME",
      "LEGACY_DB_USER",
      "LEGACY_DB_PASSWORD",
      "TARGET_DB_HOST",
      "TARGET_DB_NAME",
      "TARGET_DB_USER",
      "TARGET_DB_PASSWORD"
    ],
    "timeout_seconds": 1800,
    "dry_run_env": "SYNC_DRY_RUN"
  }
}
